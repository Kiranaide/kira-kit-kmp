CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
ENABLE_USER_SCRIPT_SANDBOXING = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../gallery/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = iosApp/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Kira Kit
INFOPLIST_KEY_UILaunchScreen_Generation = YES
IPHONEOS_DEPLOYMENT_TARGET = 16.0
// x-release-please-start-version
MARKETING_VERSION = 0.2.0
// x-release-please-end
OTHER_LDFLAGS = $(inherited) -framework KiraGallery
PRODUCT_BUNDLE_IDENTIFIER = com.kirakit.gallery
PRODUCT_NAME = $(TARGET_NAME)
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2

